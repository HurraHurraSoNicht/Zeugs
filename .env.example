# Copy this file to .env and fill in your Supabase project credentials.
# Never commit the real .env file (it is git-ignored).
# Both variables must be prefixed with EXPO_PUBLIC_ so Expo exposes them to client code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Cloudflare Turnstile site key (public, safe to expose to client code — see
# https://dash.cloudflare.com/?to=/:account/turnstile). Only used on web for
# now (see src/components/TurnstileWidget.web.tsx). Leave empty to disable
# the captcha locally, e.g. before you've set up a Turnstile site.
#
# The matching SECRET key is NOT an app setting — it goes directly into the
# Supabase Dashboard under Authentication > Attack Protection > Enable
# Captcha protection (provider: Turnstile). Never put the secret key here.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
